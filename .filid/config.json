{
  "version": "2.0",
  "language": "ko",
  "adapters": {
    "mode": "auto",
    "enabled": [
      "ecmascript"
    ]
  },
  "rules": {
    "organ-no-intentmd": {
      "enabled": true,
      "severity": "error"
    },
    "module-entry-point": {
      "enabled": true,
      "severity": "warning"
    },
    "max-depth": {
      "enabled": true,
      "severity": "error"
    },
    "circular-dependency": {
      "enabled": true,
      "severity": "error"
    },
    "pure-function-isolation": {
      "enabled": true,
      "severity": "error"
    },
    "zero-peer-file": {
      "enabled": true,
      "severity": "warning"
    }
  }
}
